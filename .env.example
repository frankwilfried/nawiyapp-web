# Google Maps API (restreindre à nawiyapp-web.vercel.app en production)
VITE_GOOGLE_MAPS_KEY=your_google_maps_api_key

# Backend WebSocket
VITE_WS_URL=wss://your-backend.onrender.com

# Backend REST API
VITE_API_URL=https://your-backend.onrender.com

# Sentry (laisser vide en dev local — activer uniquement en production)
VITE_SENTRY_DSN=

# Version app (injectée dans les releases Sentry)
VITE_APP_VERSION=0.1.0
